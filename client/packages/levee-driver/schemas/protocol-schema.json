{
	"$defs": {
		"Client": {
			"additionalProperties": false,
			"properties": {
				"details": {
					"$ref": "#/$defs/ClientDetails"
				},
				"mode": {
					"enum": ["write", "read"],
					"type": "string"
				},
				"permission": {
					"items": {
						"type": "string"
					},
					"type": "array"
				},
				"scopes": {
					"items": {
						"type": "string"
					},
					"type": "array"
				},
				"timestamp": {
					"type": "integer"
				},
				"user": {
					"$ref": "#/$defs/User"
				}
			},
			"required": ["mode", "details", "permission", "user", "scopes"],
			"type": "object"
		},
		"ClientCapabilities": {
			"additionalProperties": false,
			"properties": {
				"interactive": {
					"type": "boolean"
				}
			},
			"required": ["interactive"],
			"type": "object"
		},
		"ClientDetails": {
			"additionalProperties": false,
			"properties": {
				"capabilities": {
					"$ref": "#/$defs/ClientCapabilities"
				},
				"client_type": {
					"type": "string"
				},
				"device": {
					"type": "string"
				},
				"environment": {
					"type": "string"
				}
			},
			"required": ["capabilities"],
			"type": "object"
		},
		"ConnectionMode": {
			"enum": ["write", "read"],
			"type": "string"
		},
		"DocumentMessage": {
			"additionalProperties": false,
			"properties": {
				"client_sequence_number": {
					"type": "integer"
				},
				"compression": {
					"type": "string"
				},
				"contents": true,
				"message_type": {
					"type": "string"
				},
				"metadata": true,
				"reference_sequence_number": {
					"type": "integer"
				},
				"server_metadata": true,
				"traces": {
					"items": {
						"$ref": "#/$defs/Trace"
					},
					"type": "array"
				}
			},
			"required": [
				"client_sequence_number",
				"reference_sequence_number",
				"message_type",
				"contents"
			],
			"type": "object"
		},
		"MessageOrigin": {
			"additionalProperties": false,
			"properties": {
				"id": {
					"type": "string"
				},
				"minimum_sequence_number": {
					"type": "integer"
				},
				"sequence_number": {
					"type": "integer"
				}
			},
			"required": ["id", "sequence_number", "minimum_sequence_number"],
			"type": "object"
		},
		"Scope": {
			"enum": ["doc:read", "doc:write", "summary:write"],
			"type": "string"
		},
		"SequencedClient": {
			"additionalProperties": false,
			"properties": {
				"client": {
					"$ref": "#/$defs/Client"
				},
				"sequence_number": {
					"type": "integer"
				}
			},
			"required": ["client", "sequence_number"],
			"type": "object"
		},
		"SequencedDocumentMessage": {
			"additionalProperties": false,
			"properties": {
				"client_id": {
					"type": ["string", "null"]
				},
				"client_sequence_number": {
					"type": "integer"
				},
				"contents": true,
				"data": {
					"type": "string"
				},
				"message_type": {
					"type": "string"
				},
				"metadata": true,
				"minimum_sequence_number": {
					"type": "integer"
				},
				"origin": {
					"$ref": "#/$defs/MessageOrigin"
				},
				"reference_sequence_number": {
					"type": "integer"
				},
				"sequence_number": {
					"type": "integer"
				},
				"server_metadata": true,
				"timestamp": {
					"type": "integer"
				},
				"traces": {
					"items": {
						"$ref": "#/$defs/Trace"
					},
					"type": "array"
				}
			},
			"required": [
				"sequence_number",
				"minimum_sequence_number",
				"client_sequence_number",
				"reference_sequence_number",
				"message_type",
				"contents",
				"timestamp"
			],
			"type": "object"
		},
		"ServiceConfiguration": {
			"additionalProperties": false,
			"properties": {
				"block_size": {
					"type": "integer"
				},
				"max_message_size": {
					"type": "integer"
				},
				"noop_count_frequency": {
					"type": "integer"
				},
				"noop_time_frequency": {
					"type": "integer"
				}
			},
			"required": ["block_size", "max_message_size"],
			"type": "object"
		},
		"SignalClient": {
			"additionalProperties": false,
			"properties": {
				"client": {
					"$ref": "#/$defs/Client"
				},
				"client_connection_number": {
					"type": "integer"
				},
				"client_id": {
					"type": "string"
				},
				"reference_sequence_number": {
					"type": "integer"
				}
			},
			"required": ["client_id", "client"],
			"type": "object"
		},
		"TokenClaims": {
			"additionalProperties": false,
			"properties": {
				"document_id": {
					"type": "string"
				},
				"expiration": {
					"type": "integer"
				},
				"issued_at": {
					"type": "integer"
				},
				"jti": {
					"type": "string"
				},
				"scopes": {
					"items": {
						"type": "string"
					},
					"type": "array"
				},
				"tenant_id": {
					"type": "string"
				},
				"user": {
					"$ref": "#/$defs/User"
				},
				"version": {
					"type": "string"
				}
			},
			"required": [
				"document_id",
				"scopes",
				"tenant_id",
				"user",
				"issued_at",
				"expiration",
				"version"
			],
			"type": "object"
		},
		"Trace": {
			"additionalProperties": false,
			"properties": {
				"action": {
					"type": "string"
				},
				"service": {
					"type": "string"
				},
				"timestamp": {
					"type": "integer"
				}
			},
			"required": ["service", "action", "timestamp"],
			"type": "object"
		},
		"User": {
			"additionalProperties": false,
			"properties": {
				"id": {
					"type": "string"
				},
				"properties": {
					"additionalProperties": true,
					"type": "object"
				}
			},
			"required": ["id", "properties"],
			"type": "object"
		}
	},
	"$schema": "http://json-schema.org/draft-07/schema#",
	"additionalProperties": false,
	"properties": {
		"Client": {
			"$ref": "#/$defs/Client"
		},
		"ClientCapabilities": {
			"$ref": "#/$defs/ClientCapabilities"
		},
		"ClientDetails": {
			"$ref": "#/$defs/ClientDetails"
		},
		"ConnectionMode": {
			"$ref": "#/$defs/ConnectionMode"
		},
		"DocumentMessage": {
			"$ref": "#/$defs/DocumentMessage"
		},
		"MessageOrigin": {
			"$ref": "#/$defs/MessageOrigin"
		},
		"Scope": {
			"$ref": "#/$defs/Scope"
		},
		"SequencedClient": {
			"$ref": "#/$defs/SequencedClient"
		},
		"SequencedDocumentMessage": {
			"$ref": "#/$defs/SequencedDocumentMessage"
		},
		"ServiceConfiguration": {
			"$ref": "#/$defs/ServiceConfiguration"
		},
		"SignalClient": {
			"$ref": "#/$defs/SignalClient"
		},
		"TokenClaims": {
			"$ref": "#/$defs/TokenClaims"
		},
		"Trace": {
			"$ref": "#/$defs/Trace"
		},
		"User": {
			"$ref": "#/$defs/User"
		}
	},
	"type": "object"
}
