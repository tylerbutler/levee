# Dockerfile for building Levee server from local source
# Expects the levee repo to be available in the build context

# Build stage
FROM erlang:28-alpine AS builder

# Install build dependencies including Gleam
RUN apk add --no-cache git build-base curl

# Install Gleam (required for levee_protocol)
ARG GLEAM_VERSION=1.14.0
RUN ARCH=$(uname -m) && \
    if [ "$ARCH" = "aarch64" ]; then \
      GLEAM_ARCH="aarch64-unknown-linux-musl"; \
    else \
      GLEAM_ARCH="x86_64-unknown-linux-musl"; \
    fi && \
    curl -fsSL https://github.com/gleam-lang/gleam/releases/download/v${GLEAM_VERSION}/gleam-v${GLEAM_VERSION}-${GLEAM_ARCH}.tar.gz \
    | tar -xzC /usr/local/bin

WORKDIR /build

# Copy the Levee source from local checkout
COPY . .

# Build the Gleam server shipment
RUN cd server/levee_server && gleam deps download && gleam export erlang-shipment

# Runtime stage
FROM alpine:3.19 AS runtime

# Install runtime dependencies
RUN apk add --no-cache libstdc++ openssl ncurses-libs

WORKDIR /app

# Copy the release from builder
COPY --from=builder /build/server/levee_server/build/erlang-shipment ./

# Set runtime environment
ENV PORT=4000

# Expose the Gleam server port
EXPOSE 4000

# Health check
HEALTHCHECK --interval=5s --timeout=3s --start-period=10s --retries=3 \
    CMD wget --no-verbose --tries=1 --spider http://localhost:4000/health || exit 1

# Start the server
CMD ["./entrypoint.sh", "run"]
