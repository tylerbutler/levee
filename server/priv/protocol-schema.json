{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "additionalProperties": false,
    "properties": {
        "ConnectionMode": {
            "$ref": "#/$defs/ConnectionMode"
        },
        "User": {
            "$ref": "#/$defs/User"
        },
        "ClientCapabilities": {
            "$ref": "#/$defs/ClientCapabilities"
        },
        "ClientDetails": {
            "$ref": "#/$defs/ClientDetails"
        },
        "Client": {
            "$ref": "#/$defs/Client"
        },
        "SequencedClient": {
            "$ref": "#/$defs/SequencedClient"
        },
        "SignalClient": {
            "$ref": "#/$defs/SignalClient"
        },
        "ServiceConfiguration": {
            "$ref": "#/$defs/ServiceConfiguration"
        },
        "Trace": {
            "$ref": "#/$defs/Trace"
        },
        "MessageOrigin": {
            "$ref": "#/$defs/MessageOrigin"
        },
        "DocumentMessage": {
            "$ref": "#/$defs/DocumentMessage"
        },
        "SequencedDocumentMessage": {
            "$ref": "#/$defs/SequencedDocumentMessage"
        },
        "Scope": {
            "$ref": "#/$defs/Scope"
        },
        "TokenClaims": {
            "$ref": "#/$defs/TokenClaims"
        }
    },
    "$defs": {
        "ConnectionMode": {
            "type": "string",
            "enum": [
                "write",
                "read"
            ]
        },
        "User": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "properties": {
                    "type": "object",
                    "additionalProperties": true
                }
            },
            "required": [
                "id",
                "properties"
            ],
            "additionalProperties": false
        },
        "ClientCapabilities": {
            "type": "object",
            "properties": {
                "interactive": {
                    "type": "boolean"
                }
            },
            "required": [
                "interactive"
            ],
            "additionalProperties": false
        },
        "ClientDetails": {
            "type": "object",
            "properties": {
                "capabilities": {
                    "$ref": "#/$defs/ClientCapabilities"
                },
                "client_type": {
                    "type": "string"
                },
                "environment": {
                    "type": "string"
                },
                "device": {
                    "type": "string"
                }
            },
            "required": [
                "capabilities"
            ],
            "additionalProperties": false
        },
        "Client": {
            "type": "object",
            "properties": {
                "mode": {
                    "type": "string",
                    "enum": [
                        "write",
                        "read"
                    ]
                },
                "details": {
                    "$ref": "#/$defs/ClientDetails"
                },
                "permission": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "user": {
                    "$ref": "#/$defs/User"
                },
                "scopes": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "timestamp": {
                    "type": "integer"
                }
            },
            "required": [
                "mode",
                "details",
                "permission",
                "user",
                "scopes"
            ],
            "additionalProperties": false
        },
        "SequencedClient": {
            "type": "object",
            "properties": {
                "client": {
                    "$ref": "#/$defs/Client"
                },
                "sequence_number": {
                    "type": "integer"
                }
            },
            "required": [
                "client",
                "sequence_number"
            ],
            "additionalProperties": false
        },
        "SignalClient": {
            "type": "object",
            "properties": {
                "client_id": {
                    "type": "string"
                },
                "client": {
                    "$ref": "#/$defs/Client"
                },
                "client_connection_number": {
                    "type": "integer"
                },
                "reference_sequence_number": {
                    "type": "integer"
                }
            },
            "required": [
                "client_id",
                "client"
            ],
            "additionalProperties": false
        },
        "ServiceConfiguration": {
            "type": "object",
            "properties": {
                "block_size": {
                    "type": "integer"
                },
                "max_message_size": {
                    "type": "integer"
                },
                "noop_time_frequency": {
                    "type": "integer"
                },
                "noop_count_frequency": {
                    "type": "integer"
                }
            },
            "required": [
                "block_size",
                "max_message_size"
            ],
            "additionalProperties": false
        },
        "Trace": {
            "type": "object",
            "properties": {
                "service": {
                    "type": "string"
                },
                "action": {
                    "type": "string"
                },
                "timestamp": {
                    "type": "integer"
                }
            },
            "required": [
                "service",
                "action",
                "timestamp"
            ],
            "additionalProperties": false
        },
        "MessageOrigin": {
            "type": "object",
            "properties": {
                "id": {
                    "type": "string"
                },
                "sequence_number": {
                    "type": "integer"
                },
                "minimum_sequence_number": {
                    "type": "integer"
                }
            },
            "required": [
                "id",
                "sequence_number",
                "minimum_sequence_number"
            ],
            "additionalProperties": false
        },
        "DocumentMessage": {
            "type": "object",
            "properties": {
                "client_sequence_number": {
                    "type": "integer"
                },
                "reference_sequence_number": {
                    "type": "integer"
                },
                "message_type": {
                    "type": "string"
                },
                "contents": true,
                "metadata": true,
                "server_metadata": true,
                "traces": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/Trace"
                    }
                },
                "compression": {
                    "type": "string"
                }
            },
            "required": [
                "client_sequence_number",
                "reference_sequence_number",
                "message_type",
                "contents"
            ],
            "additionalProperties": false
        },
        "SequencedDocumentMessage": {
            "type": "object",
            "properties": {
                "client_id": {
                    "type": [
                        "string",
                        "null"
                    ]
                },
                "sequence_number": {
                    "type": "integer"
                },
                "minimum_sequence_number": {
                    "type": "integer"
                },
                "client_sequence_number": {
                    "type": "integer"
                },
                "reference_sequence_number": {
                    "type": "integer"
                },
                "message_type": {
                    "type": "string"
                },
                "contents": true,
                "metadata": true,
                "server_metadata": true,
                "origin": {
                    "$ref": "#/$defs/MessageOrigin"
                },
                "traces": {
                    "type": "array",
                    "items": {
                        "$ref": "#/$defs/Trace"
                    }
                },
                "timestamp": {
                    "type": "integer"
                },
                "data": {
                    "type": "string"
                }
            },
            "required": [
                "sequence_number",
                "minimum_sequence_number",
                "client_sequence_number",
                "reference_sequence_number",
                "message_type",
                "contents",
                "timestamp"
            ],
            "additionalProperties": false
        },
        "Scope": {
            "type": "string",
            "enum": [
                "doc:read",
                "doc:write",
                "summary:write"
            ]
        },
        "TokenClaims": {
            "type": "object",
            "properties": {
                "document_id": {
                    "type": "string"
                },
                "scopes": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "tenant_id": {
                    "type": "string"
                },
                "user": {
                    "$ref": "#/$defs/User"
                },
                "issued_at": {
                    "type": "integer"
                },
                "expiration": {
                    "type": "integer"
                },
                "version": {
                    "type": "string"
                },
                "jti": {
                    "type": "string"
                }
            },
            "required": [
                "document_id",
                "scopes",
                "tenant_id",
                "user",
                "issued_at",
                "expiration",
                "version"
            ],
            "additionalProperties": false
        }
    }
}
